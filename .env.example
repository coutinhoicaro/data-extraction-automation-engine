# ===============================================
# Data Extraction & Automation Engine Configuration
# ===============================================

# Database Settings
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_dev_password
POSTGRES_DB=data_warehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Queue Broker
REDIS_URL=redis://redis:6379/0

# Proxy & Provider Configurations (Mock / Sandbox)
PROXY_PROVIDER_URL=https://api.proxyprovider.network/v1/pool
MAX_WORKER_CONCURRENCY=8
MAX_RETRY_ATTEMPTS=3

# AI & Processing Settings
WHISPER_MODEL_SIZE=base
LOG_LEVEL=INFO
